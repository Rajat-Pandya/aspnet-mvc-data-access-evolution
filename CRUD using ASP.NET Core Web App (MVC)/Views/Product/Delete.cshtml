@model CRUD_using_ASP.NET_Core_Web_App__MVC_.Models.Products

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="text-danger">Delete Product</h2>
<h5>Are you sure you want to delete this product?</h5>
<hr />

<div class="card col-md-6 p-3 border-danger">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ProductID)</dt>
        <dd class="col-sm-8">@Model.ProductID</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ProductName)</dt>
        <dd class="col-sm-8">@Model.ProductName</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Quantity)</dt>
        <dd class="col-sm-8">@Model.Quantity</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductID" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>